## 3. API Resources for Enriched Responses

Use `JsonResource` when the enrollment-service enriches responses with student/course names fetched from other services:

```php
// app/Http/Resources/EnrollmentResource.php
namespace App\Http\Resources;

use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\JsonResource;

class EnrollmentResource extends JsonResource
{
    // Pass enrichment data via constructor
    public function __construct($resource, private array $enrichment = [])
    {
        parent::__construct($resource);
    }

    public function toArray(Request $request): array
    {
        return [
            'id'           => $this->id,
            'student_id'   => $this->student_id,
            'course_id'    => $this->course_id,
            'enrolled_at'  => $this->enrolled_at,
            'student_name' => $this->enrichment['student_name'] ?? null,
            'course_name'  => $this->enrichment['course_name'] ?? null,
            'created_at'   => $this->created_at->toISOString(),
        ];
    }
}

// In EnrollmentController::index()
public function index(): AnonymousResourceCollection
{
    $enrollments = Enrollment::all();

    return EnrollmentResource::collection(
        $enrollments->map(function ($enrollment) {
            $student = Http::get("http://localhost:8001/api/students/{$enrollment->student_id}");
            $course  = Http::get("http://localhost:8002/api/courses/{$enrollment->course_id}");

            return new EnrollmentResource($enrollment, [
                'student_name' => $student->ok() ? $student->json('full_name') : 'Unknown',
                'course_name'  => $course->ok()  ? $course->json('name')       : 'Unknown',
            ]);
        })
    );
}
```

