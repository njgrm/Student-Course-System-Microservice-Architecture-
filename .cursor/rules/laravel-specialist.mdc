## 2. Feature Test Structure (use for ALL services)

Every feature test MUST follow this structure:

```php
namespace Tests\Feature;

use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

class StudentApiTest extends TestCase
{
    use RefreshDatabase; // Always — never leave dirty state between tests

    public function test_can_list_students(): void
    {
        Student::factory()->count(3)->create();

        $this->getJson('/api/students')
            ->assertStatus(200)
            ->assertJsonCount(3);
    }

    public function test_can_create_student(): void
    {
        $this->postJson('/api/students', [
            'full_name' => 'Alice Smith',
            'email'     => 'alice@example.com',
            'age'       => 22,
        ])
        ->assertStatus(201)
        ->assertJsonStructure(['id', 'full_name', 'email', 'age']);

        $this->assertDatabaseHas('students', ['email' => 'alice@example.com']);
    }

    public function test_validation_requires_unique_email(): void
    {
        Student::factory()->create(['email' => 'alice@example.com']);

        $this->postJson('/api/students', [
            'full_name' => 'Alice Again',
            'email'     => 'alice@example.com',
            'age'       => 25,
        ])
        ->assertStatus(422)
        ->assertJsonValidationErrors(['email']);
    }

    public function test_can_delete_student(): void
    {
        $student = Student::factory()->create();

        $this->deleteJson("/api/students/{$student->id}")
            ->assertStatus(200);

        $this->assertDatabaseMissing('students', ['id' => $student->id]);
    }
}
```

